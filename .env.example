# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://expocontact.uz

# ── CMS Admin ────────────────────────────────────────────────────────────────
# Password for the /admin panel (default: admin123)
ADMIN_PASSWORD=admin123

# ── Contact form → Telegram ──────────────────────────────────────────────────
# Token from @BotFather (/newbot, or /mybots → API Token for an existing bot).
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Where leads go. Personal chat: your numeric id (@userinfobot shows it) — and
# you must message the bot first, or Telegram answers "chat not found".
# Group: add the bot to it; the group id is negative (e.g. -1001234567890,
# @getidsbot or the getUpdates method show it). Channel: make the bot an admin.
# After setting both, /admin → Проверить sends a test message and names what
# is wrong if it does not arrive.
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Vercel Blob (image storage) ──────────────────────────────────────────────
# Used by /api/admin/upload and for seed images. Auto-set by the Vercel Blob
# integration; for local uploads create a token in the Vercel dashboard
# (Storage → Blob → Tokens).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ── Yandex.Metrika (analytics dashboard) ─────────────────────────────────────
# OAuth token from https://oauth.yandex.ru/ — enables the Metrika-backed
# analytics view in /admin. Without it the dashboard falls back to local data.
YANDEX_METRIKA_TOKEN=your_metrika_oauth_token

# ── Leads database (personal data — never store these in Blob) ───────────────
# Connect Upstash Redis from Vercel → Storage; the integration sets these for
# you. The code accepts ANY variable pair ending in KV_REST_API_URL /
# KV_REST_API_TOKEN (or UPSTASH_REDIS_REST_URL / _TOKEN), whatever prefix the
# integration adds, and probes each pair until one answers — so a leftover pair
# from a retired store cannot shadow the working one.
KV_REST_API_URL=https://xxx.upstash.io
KV_REST_API_TOKEN=your_upstash_token

# ── Daily "what is burning" digest to Telegram ───────────────────────────────
# Vercel attaches this as `Authorization: Bearer <value>` to the scheduled call
# declared in vercel.json (09:00 Tashkent). Without it the schedule cannot
# authenticate and the digest never goes out — the admin dashboard shows this
# as a red row. Any long random string works.
CRON_SECRET=generate_a_long_random_string
